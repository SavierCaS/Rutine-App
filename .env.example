APP_ENV=production
APP_DEBUG=false

# Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_aqui
DB_NAME=kynap_db

# Seguridad de Tokens
KYNAP_AUTH_SECRET=cambia_esta_clave_por_una_cadena_secreta_aleatoria_segura
KYNAP_TOKEN_EXPIRATION_SECONDS=2592000

# Groq API (Llama)
GROQ_API_KEY=gsk_tu_clave_de_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
